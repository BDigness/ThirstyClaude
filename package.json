{
  "name": "thirstyclaude",
  "productName": "ThirstyClaude",
  "version": "2.9.0",
  "private": true,
  "description": "A desktop widget that fills with the estimated water behind your Claude Code and Codex tokens",
  "main": "main.js",
  "bin": {
    "thirstyclaude": "bin/launch.js"
  },
  "scripts": {
    "start": "node bin/launch.js",
    "dev": "electron .",
    "demo": "electron . --demo"
  },
  "files": [
    "main.js",
    "scanner.js",
    "model.js",
    "logread.js",
    "statusline.js",
    "preload.js",
    "index.html",
    "renderer.js",
    "scenes.js",
    "bin/",
    "README.md",
    "LICENSE"
  ],
  "repository": {
    "type": "git",
    "url": "git+https://github.com/BDigness/ThirstyClaude.git"
  },
  "keywords": [
    "claude",
    "claude-code",
    "tokens",
    "water",
    "electron",
    "tray",
    "widget"
